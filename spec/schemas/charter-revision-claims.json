{
  "$defs": {
    "tagged_digest": {
      "type": "string",
      "minLength": 51,
      "maxLength": 51
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 64
    },
    "extension_envelope": {
      "type": "object",
      "required": [
        "critical",
        "optional"
      ],
      "properties": {
        "critical": {
          "type": "object",
          "additionalProperties": true
        },
        "optional": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "party_binding": {
      "type": "object",
      "required": [
        "party_descriptor_digest",
        "role"
      ],
      "properties": {
        "party_descriptor_digest": {
          "$ref": "#/$defs/tagged_digest"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "participation": {
          "enum": [
            "acceptor",
            "arbiter"
          ]
        }
      },
      "additionalProperties": false
    },
    "legal_text": {
      "type": "object",
      "required": [
        "content_digest",
        "media_type"
      ],
      "properties": {
        "content_digest": {
          "$ref": "#/$defs/tagged_digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "uri_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "required": [
        "basis"
      ],
      "properties": {
        "basis": {
          "enum": [
            "bound_deployments",
            "legal_text"
          ]
        },
        "detail_digest": {
          "$ref": "#/$defs/tagged_digest"
        }
      },
      "additionalProperties": false
    },
    "termination_rules": {
      "type": "object",
      "required": [
        "reason_codes"
      ],
      "properties": {
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "quorum": {
          "$ref": "#/$defs/quorum"
        }
      },
      "additionalProperties": false
    },
    "abp_binding": {
      "type": "object",
      "required": [
        "party_role",
        "blueprint_id",
        "release_number",
        "content_digest",
        "deployment_digest"
      ],
      "properties": {
        "party_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "blueprint_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "release_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_digest": {
          "$ref": "#/$defs/tagged_digest"
        },
        "deployment_digest": {
          "$ref": "#/$defs/tagged_digest"
        }
      },
      "additionalProperties": false
    },
    "quorum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "threshold"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "party_replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "assignor_party_id",
        "assignor_descriptor_digest",
        "assignee_descriptor_digest",
        "assent_quorum"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assignor_party_id": {
          "$ref": "#/$defs/tagged_digest"
        },
        "assignor_descriptor_digest": {
          "$ref": "#/$defs/tagged_digest"
        },
        "assignee_descriptor_digest": {
          "$ref": "#/$defs/tagged_digest"
        },
        "assent_quorum": {
          "$ref": "#/$defs/quorum"
        }
      }
    }
  },
  "type": "object",
  "required": [
    "protocol_revision",
    "revision_number",
    "parties",
    "legal_text",
    "precedence_declaration",
    "attribution_declaration",
    "effective_from",
    "termination_rules",
    "abp_bindings",
    "receipt_profile",
    "extensions"
  ],
  "properties": {
    "protocol_revision": {
      "enum": [
        1,
        2,
        8
      ]
    },
    "charter_id": {
      "$ref": "#/$defs/tagged_digest"
    },
    "revision_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "prev_revision_digest": {
      "$ref": "#/$defs/tagged_digest"
    },
    "parties": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/party_binding"
      }
    },
    "legal_text": {
      "$ref": "#/$defs/legal_text"
    },
    "precedence_declaration": {
      "enum": [
        "legal_text_governs",
        "machine_terms_govern"
      ]
    },
    "attribution_declaration": {
      "$ref": "#/$defs/attribution"
    },
    "effective_from": {
      "$ref": "#/$defs/timestamp"
    },
    "effective_until": {
      "$ref": "#/$defs/timestamp"
    },
    "termination_rules": {
      "$ref": "#/$defs/termination_rules"
    },
    "abp_bindings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/abp_binding"
      }
    },
    "receipt_profile": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512
    },
    "supersedes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/tagged_digest"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extension_envelope"
    },
    "acceptance_quorum": {
      "$ref": "#/$defs/quorum"
    },
    "party_replacements": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/party_replacement"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol_revision": {
            "const": 8
          }
        }
      },
      "then": {
        "required": [
          "acceptance_quorum"
        ],
        "properties": {
          "parties": {
            "items": {
              "required": [
                "participation"
              ]
            }
          },
          "termination_rules": {
            "required": [
              "quorum"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "parties": {
            "maxItems": 2,
            "items": {
              "not": {
                "required": [
                  "participation"
                ]
              }
            }
          },
          "termination_rules": {
            "not": {
              "required": [
                "quorum"
              ]
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "acceptance_quorum"
              ]
            },
            {
              "required": [
                "party_replacements"
              ]
            }
          ]
        }
      }
    }
  ]
}
