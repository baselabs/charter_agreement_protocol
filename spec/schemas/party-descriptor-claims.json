{
  "$defs": {
    "tagged_digest": {"type": "string", "minLength": 51, "maxLength": 51},
    "timestamp": {"type": "string", "minLength": 20, "maxLength": 64},
    "extension_envelope": {
      "type": "object",
      "required": ["critical", "optional"],
      "properties": {
        "critical": {"type": "object", "additionalProperties": true},
        "optional": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "verification_key": {
      "type": "object",
      "required": ["key_id", "algorithm", "public_key", "status"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "algorithm": {"enum": ["Ed25519"]},
        "public_key": {"type": "string", "minLength": 43, "maxLength": 43},
        "status": {"enum": ["active", "retired"]}
      },
      "additionalProperties": false
    },
    "attestation_hint": {
      "type": "object",
      "required": ["kind", "uri"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "uri": {"type": "string", "minLength": 1, "maxLength": 2048}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "protocol_revision",
    "descriptor_number",
    "verification_keys",
    "attestation_hints",
    "extensions",
    "effective_from"
  ],
  "properties": {
    "protocol_revision": {"type": "integer", "minimum": 1, "maximum": 2},
    "party_id": {"$ref": "#/$defs/tagged_digest"},
    "descriptor_number": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "prev_descriptor_digest": {"$ref": "#/$defs/tagged_digest"},
    "verification_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/verification_key"}
    },
    "attestation_hints": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/attestation_hint"}
    },
    "extensions": {"$ref": "#/$defs/extension_envelope"},
    "effective_from": {"$ref": "#/$defs/timestamp"}
  },
  "additionalProperties": false
}
